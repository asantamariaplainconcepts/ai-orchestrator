<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AiOrchestrator.Modules.Projects</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The starter catalogue (#190). Embedded rather than copied to output so the bytes a test
         loads are the bytes the endpoint serves — the "behaves the same outside this product"
         criterion is only checkable if there is one artifact. -->
    <EmbeddedResource Include="..\..\..\..\prompts\starter\manifest.json" LinkBase="Starter" />
    <EmbeddedResource Include="..\..\..\..\prompts\starter\**\*.md" LinkBase="Starter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\AiOrchestrator.BuildingBlocks\AiOrchestrator.BuildingBlocks.csproj" />
    <!-- Contracts only, never the implementation: the Projects module ensures trigger labels
         exist at the vendor without knowing which vendor that is (MOD002). -->
    <ProjectReference Include="..\..\Backlog\AiOrchestrator.Modules.Backlog.Contracts\AiOrchestrator.Modules.Backlog.Contracts.csproj" />
    <!-- Contracts only: deleting an Automation asks the Runs module whether any Run used it
         (MOD002). Runs consumes this module's contracts in turn — Contracts-to-Contracts is not
         a cycle. -->
    <ProjectReference Include="..\..\Runs\AiOrchestrator.Modules.Runs.Contracts\AiOrchestrator.Modules.Runs.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests drive the module's internals (DbContext, handlers) directly; the module's public
         surface stays empty by design (MOD003/MOD001). -->
    <InternalsVisibleTo Include="AiOrchestrator.Modules.Projects.UnitTests" />
    <InternalsVisibleTo Include="AiOrchestrator.Modules.Projects.FunctionalTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiOrchestrator.Modules.Projects.Contracts\AiOrchestrator.Modules.Projects.Contracts.csproj" />
  </ItemGroup>
</Project>
