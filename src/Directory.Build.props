<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
      >true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Auto-attach the module boundary analyzers to every `.Modules.*` implementation
       project (not test projects, which also match `.Modules.` in their name). -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Modules.')) AND !$(MSBuildProjectName.EndsWith('Tests'))">
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)shared\AiOrchestrator.ArchitectureAnalyzers\AiOrchestrator.ArchitectureAnalyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <!-- One-time, idempotent commit-hook activation: point git at .husky/ (repo root) on the first
       build, so a fresh clone gets hooks with no manual step. Hooked to BeforeBuild rather than
       Restore — solution-level `dotnet restore`/`dotnet build` use a static-graph restore that
       skips BeforeTargets="Restore" custom targets, but BeforeBuild always runs. Skipped in
       CI / HUSKY=0; `git config` is a no-op if the value is already set, so re-running is harmless. -->
  <Target
    Name="HuskyInstall"
    BeforeTargets="BeforeBuild"
    Condition="'$(HUSKY)' != '0' AND '$(CI)' != 'true' AND '$(GITHUB_ACTIONS)' != 'true'"
  >
    <!-- Read before write: a solution build runs this target once per project, and concurrent
         writers collide on .git/config's lock file. Once the value is set, every later project
         short-circuits here instead of racing. -->
    <Exec
      Command="git config --get core.hooksPath"
      WorkingDirectory="$(MSBuildThisFileDirectory).."
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      ContinueOnError="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low"
    >
      <Output TaskParameter="ConsoleOutput" PropertyName="ConfiguredHooksPath" />
    </Exec>

    <Exec
      Command="git config core.hooksPath .husky"
      Condition="'$(ConfiguredHooksPath)' != '.husky'"
      WorkingDirectory="$(MSBuildThisFileDirectory).."
      ContinueOnError="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low"
    />
  </Target>
</Project>
