<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AiOrchestrator.DispatchWorker</RootNamespace>
  </PropertyGroup>

  <!-- The image, owned by the SDK (#257). The base is EXPLICITLY aspnet, not inferred:
       BuildingBlocks framework-references Microsoft.AspNetCore.App, so the shared framework is
       required transitively however little of it a queue-draining process uses — the lesson the
       migration image learned the hard way (#8), made unmakeable instead of remembered. -->
  <PropertyGroup>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>asantamariaplainconcepts/ai-orchestrator/dispatch-worker</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <ContainerUser>app</ContainerUser>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\AiOrchestrator.BuildingBlocks\AiOrchestrator.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\shared\AiOrchestrator.ServiceDefaults\AiOrchestrator.ServiceDefaults.csproj" />
    <!-- Modules are referenced so their assemblies land beside the executable, where discovery finds them. -->
    <ProjectReference Include="..\..\modules\Projects\AiOrchestrator.Modules.Projects\AiOrchestrator.Modules.Projects.csproj" />
    <ProjectReference Include="..\..\modules\Backlog\AiOrchestrator.Modules.Backlog\AiOrchestrator.Modules.Backlog.csproj" />
    <ProjectReference Include="..\..\modules\Runs\AiOrchestrator.Modules.Runs\AiOrchestrator.Modules.Runs.csproj" />
  </ItemGroup>
</Project>
