<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AiOrchestrator.MigrationService</RootNamespace>
  </PropertyGroup>

  <!-- The image, owned by the SDK (#257). The base is EXPLICITLY aspnet, not inferred:
       BuildingBlocks framework-references Microsoft.AspNetCore.App, so the shared framework is
       required however little of it the migrator uses — the runtime-image mistake was made twice
       in hand-written Dockerfiles (#8), and an explicit base makes it unmakeable. -->
  <PropertyGroup>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>asantamariaplainconcepts/ai-orchestrator/migrations</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <ContainerUser>app</ContainerUser>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\AiOrchestrator.BuildingBlocks\AiOrchestrator.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\shared\AiOrchestrator.Infrastructure\AiOrchestrator.Infrastructure.csproj" />
    <!-- Modules are referenced so their assemblies land beside the executable, where
         ModuleRegistration.Discover finds them — the same mechanism the Server uses. -->
    <ProjectReference Include="..\..\modules\Projects\AiOrchestrator.Modules.Projects\AiOrchestrator.Modules.Projects.csproj" />
    <ProjectReference Include="..\..\modules\Backlog\AiOrchestrator.Modules.Backlog\AiOrchestrator.Modules.Backlog.csproj" />
    <ProjectReference Include="..\..\modules\Runs\AiOrchestrator.Modules.Runs\AiOrchestrator.Modules.Runs.csproj" />
  </ItemGroup>
</Project>
